local workflow_id = borg_workflow_id(1)
local artifact_dir = ".borg/harvey-lab/runs/" .. workflow_id
local command = "python3 -u .borg/extensions/harvey-lab/workflows/runner.py --root . run --workflow-id " .. workflow_id
local execution = borg_exec(2, command, ".", 1000, 1800000, 64000)
local receipt = borg_plugin_store(3, "{\"op\":\"commit\",\"scope\":\"project\",\"idempotency_key\":\"run/" .. workflow_id .. "\",\"writes\":[{\"op\":\"put\",\"key\":\"runs/" .. workflow_id .. "\",\"value\":{\"workflow_id\":\"" .. workflow_id .. "\",\"benchmark\":\"harvey-lab\",\"phase\":\"run\",\"state\":\"recorded\",\"artifact_path\":\"" .. artifact_dir .. "/run.json\"}}],\"artifacts\":[{\"artifact_id\":\"run-" .. workflow_id .. "\",\"path\":\"" .. artifact_dir .. "/run.json\",\"run_id\":\"" .. workflow_id .. "\",\"media_type\":\"application/json\",\"metadata\":{\"kind\":\"harvey_run_record\",\"source\":\"harvey-lab-adapter\"}},{\"artifact_id\":\"metrics-" .. workflow_id .. "\",\"path\":\"" .. artifact_dir .. "/metrics.json\",\"run_id\":\"" .. workflow_id .. "\",\"media_type\":\"application/json\",\"metadata\":{\"kind\":\"harvey_run_metrics\",\"source\":\"harvey-lab-adapter\"}}],\"provenance\":{\"workflow_id\":\"" .. workflow_id .. "\",\"extension_id\":\"harvey-lab\",\"phase\":\"run\",\"benchmark\":\"harvey-lab\",\"authority\":\"harvey-lab-adapter\"}}")
borg_assert_exec_success(4, execution)
return receipt

#!/bin/sh
set -eu

extension_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
surf_root=${SURF_LAB_ROOT:-"$extension_dir/../../../../surf"}

if [ -n "${SURF_LAB_BIN:-}" ]; then
    surf_bin=$SURF_LAB_BIN
else
    surf_bin=
    surf_bin_mtime=0
    for candidate in "$surf_root/target/release/surf_lab" "$surf_root/target/debug/surf_lab"; do
        if [ ! -x "$candidate" ]; then
            continue
        fi
        newer_source=$(find "$surf_root/src" "$surf_root/Cargo.toml" "$surf_root/Cargo.lock" \
            -type f -newer "$candidate" -print -quit 2>/dev/null || true)
        if [ -n "$newer_source" ]; then
            continue
        fi
        candidate_mtime=$(stat -c '%Y' "$candidate")
        if [ -z "$surf_bin" ] || [ "$candidate_mtime" -gt "$surf_bin_mtime" ]; then
            surf_bin=$candidate
            surf_bin_mtime=$candidate_mtime
        fi
    done
    if [ -z "$surf_bin" ]; then
        echo "no fresh surf_lab executable found under $surf_root" >&2
        echo "build target/release/surf_lab or target/debug/surf_lab, or set SURF_LAB_BIN" >&2
        exit 127
    fi
fi

exec "$surf_bin" "$@"
